# Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Feature Flags
VITE_ENABLE_FAUCET="false"

# Monad Network Configuration (Mainnet)
# Official mainnet chainId: 143
# RPC endpoints: https://rpc.monad.xyz (also rpc1/2/3.monad.xyz)
# Explorer (choose one): https://monadscan.com or https://monadvision.com
MONAD_CHAIN_ID="143"
MONAD_RPC_URL="https://rpc.monad.xyz"
MONAD_EXPLORER_URL="https://monadscan.com"

# Deployed contract addresses
MONAD_BONDING_CURVE_ADDRESS="0xA87F1E8EE6bC24D628f9C5d03e8736e5bF32c809"
MONAD_LOGGER_ADDRESS=""

# Strava Configuration (Optional - for Strava integration)
# Get these values by creating a Strava API application at:
# https://www.strava.com/settings/api
#
VITE_STRAVA_CLIENT_ID="172877"
VITE_STRAVA_REDIRECT_URI="https://ssnehmposgsczoadycms.functions.supabase.co/strava-oauth-exchange"
#
# Note: STRAVA_CLIENT_SECRET should be stored in Supabase Secrets, not in .env
# Use the Supabase dashboard to add it: Settings > Edge Functions > Secrets

# VITE_STRAVA_CLIENT_ID="138859"
# VITE_STRAVA_REDIRECT_URI="http://localhost:5173/strava/callback"
